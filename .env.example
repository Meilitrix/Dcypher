# Decypher orchestrator port
PORT=8787

# Which agent adapter to use: "mock" (default, deterministic) or "bob" (live IBM Bob 2.0).
AGENT=mock

# IBM Bob 2.0 (only needed when AGENT=bob). Decypher falls back to mock if unset.
BOB_API_BASE=
BOB_API_KEY=
BOB_MODEL=

# Origin allowed to call the API (the web UI dev server).
WEB_ORIGIN=http://localhost:5173
