# Decypher orchestrator port
PORT=8787

# Which agent adapter to use: "mock" (default, deterministic) or "bob" (live IBM Bob 2.0).
AGENT=mock

# IBM Bob 2.0 — required when AGENT=bob.
# Decypher falls back to the deterministic mock automatically if these are unset or if a call fails.
#
# API base: the inference endpoint (no trailing slash).
BOB_API_BASE=https://api.us-east.bob.ibm.com/inference/v1
#
# API key: your IBM Cloud API key. The Authorization header will be sent as "Apikey <key>".
BOB_API_KEY=
#
# Model name (defaults to "premium" if unset).
BOB_MODEL=premium
#
# Request timeout in milliseconds (default 60000 = 60 s).
BOB_TIMEOUT_MS=60000

# Origin allowed to call the API (the web UI dev server).
WEB_ORIGIN=http://localhost:5173
