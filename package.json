{
  "name": "decypher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Decypher — a control and comprehension layer over AI coding agents (IBM Bob 2.0). Plan before change, protect what matters, compare before and after.",
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:server": "tsx server.ts",
    "dev:web": "vite",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.12",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
